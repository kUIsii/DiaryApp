<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_item_background"
    android:padding="8dp">

    <!-- Checkbox -->
    <CheckBox
        android:id="@+id/cb_todo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:button="@drawable/widget_checkbox_selector"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary"
            android:maxLines="2"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <!-- Priority indicator -->
            <View
                android:id="@+id/view_priority"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_priority_indicator"
                android:layout_gravity="center_vertical"
                android:visibility="gone" />

            <!-- Category tag -->
            <TextView
                android:id="@+id/tv_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/widget_accent"
                android:background="@drawable/widget_tag_background"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

            <!-- Due date -->
            <TextView
                android:id="@+id/tv_due_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
